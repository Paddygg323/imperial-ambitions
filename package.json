{
  "name": "imperial-ambitions",
  "version": "0.2.59",
  "private": true,
  "description": "Standalone strategy game and complete sprite-design handover",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node game/server.cjs",
    "play": "node scripts/launch.mjs",
    "sync": "node scripts/sync.mjs",
    "sprites": "node outputs/sprite-library-review/serve.cjs",
    "build:web": "node scripts/export-web.mjs",
    "android:apk": "node scripts/android.mjs",
    "android:bundle": "node scripts/android.mjs --bundle",
    "test:delivery": "node --test scripts/test/*.test.mjs",
    "test": "node scripts/test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "devDependencies": { "playwright": "1.62.1" }
}
